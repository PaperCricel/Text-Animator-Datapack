type Timing = struct {
    cd?: int,
    delay?: int,
}

type TextElement = (
    struct {
        [string]: any,
        text: string,
        ...Timing,
    } |
    struct {
        command: string,
        delay?: int,
    } |
)

type Script = (
    struct {
        mode?: "text",
        text?: [TextElement],
        ...Timing,
        no_clear?: boolean,
    } |
    struct {
        mode: "reverse",
        count?: int,
        speed?: int,
        no_sound?: boolean,
        ...Timing,
    } |
)

type Sound = struct {
    id: string,
    source?: string,
    target?: string,
    volume?: float,
    pitch?: float,
}

type DisplayNbt = struct {
    [string]: any,
}

type SettingsBase = struct {
    id: string,
    ...Timing,
    sound?: Sound,
    nbt?: DisplayNbt,
}

type Settings = (
    struct {
        mode?: "hover",
        ...SettingsBase,
    } |
    struct {
        mode: "title",
        ...SettingsBase,
        selector?: string,
        "type"?: ("title" | "subtitle" | "actionbar"),
    } |
)

dispatch :storage[text:main] to struct {
    script?: [Script],
    settings?: Settings,
    [string]: any,
}
